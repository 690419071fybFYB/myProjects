MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_DATABASE=hiolabsDB
MYSQL_BACKUP_CRON=0 3 * * *

# WeChat mini program / payment
WEIXIN_APPID=
WEIXIN_SECRET=
WEIXIN_MCH_ID=
WEIXIN_PARTNER_KEY=
WEIXIN_NOTIFY_URL=https://api.fybshop.site/api/pay/notify

# VIP (phase 1)
VIP_ENABLED=true
VIP_DEFAULT_YEAR_PRICE=69
VIP_DEFAULT_QUARTER_PRICE=25
VIP_MONTHLY_COUPON_ID=0
VIP_MONTHLY_COUPON_COUNT=6
VIP_MONTHLY_COUPON_VALID_DAYS=30

# WeChat papay auto-renew (phase 2)
WEIXIN_PAPAY_SERVICE_ID=
WEIXIN_PAPAY_NOTIFY_URL=
WEIXIN_PAPAY_MCH_ID=
WEIXIN_PAPAY_API_V3_KEY=
WEIXIN_PAPAY_SERIAL_NO=
WEIXIN_PAPAY_PRIVATE_KEY_PATH=
WEIXIN_PAPAY_PLATFORM_CERT_PATH=

# COS credentials (recommended)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=fybshopbk-1369967353
COS_REGION=ap-shanghai
COS_DOMAIN=https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com

# Backward-compatible OSS env names (optional)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Caddy entry defaults (local test)
# local URLs:
#   https://api.localhost:18443
#   https://admin.localhost:18443
CADDYFILE_PATH=./caddy/Caddyfile.local
CADDY_HTTP_PORT=18080
CADDY_HTTPS_PORT=18443
BT_CERTS_PATH=./certs

# Production Caddy settings
ACME_EMAIL=you@example.com
API_DOMAIN=api.fybshop.site
ADMIN_DOMAIN=admin.fybshop.site
